{
  "Comment": "Crea un draw de forma idempotente, espera hasta closesAt y asigna las balls y el videoId de un video elegido al azar.",
  "StartAt": "CreateDraw",
  "States": {
    "CreateDraw": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CreateDrawFunctionArn}",
        "Payload.$": "$"
      },
      "Retry": [
        {
          "ErrorEquals": ["DrawConflictError"],
          "IntervalSeconds": 1,
          "BackoffRate": 2,
          "MaxAttempts": 5
        },
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "OutputPath": "$.Payload",
      "Next": "WaitUntilClosesAt"
    },
    "WaitUntilClosesAt": {
      "Type": "Wait",
      "TimestampPath": "$.closesAt",
      "Next": "DrawVideo"
    },
    "DrawVideo": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${DrawVideoFunctionArn}",
        "Payload.$": "$"
      },
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "OutputPath": "$.Payload",
      "End": true
    }
  }
}
