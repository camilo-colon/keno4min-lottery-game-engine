{
    "Comment": "Lottery Game Workflow",
    "StartAt": "CreateGame",
    "States": {
        "CreateGame": {
            "Type": "Task",
            "Resource": "${CreateGameFunctionArn}",
            "ResultPath": "$.game",
            "Retry": [
                {
                    "ErrorEquals": [
                        "States.TaskFailed"
                    ],
                    "IntervalSeconds": 2,
                    "MaxAttempts": 3,
                    "BackoffRate": 2
                }
            ],
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "Next": "HandleError"
                }
            ],
            "Next": "WaitForBetsClose"
        },
        "WaitForBetsClose": {
            "Type": "Wait",
            "TimestampPath": "$.game.closesAt",
            "Next": "DrawBalls"
        },
        "DrawBalls": {
            "Type": "Task",
            "Resource": "${DrawBallsFunctionArn}",
            "Parameters": {
                "gameId.$": "$.game.id"
            },
            "ResultPath": "$.game",
            "Retry": [
                {
                    "ErrorEquals": [
                        "States.TaskFailed"
                    ],
                    "IntervalSeconds": 2,
                    "MaxAttempts": 3,
                    "BackoffRate": 2
                }
            ],
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "Next": "HandleError"
                }
            ],
            "Next": "SettleTickets"
        },
        "SettleTickets": {
            "Type": "Parallel",
            "ResultPath": "$.settleResults",
            "Branches": [
                {
                    "StartAt": "UpdateTicketsKeno4min",
                    "States": {
                        "UpdateTicketsKeno4min": {
                            "Type": "Task",
                            "Resource": "${UpdateTicketsKeno4minFunctionArn}",
                            "Parameters": {
                                "game.$": "$.game"
                            },
                            "Retry": [
                                {
                                    "ErrorEquals": [
                                        "States.TaskFailed"
                                    ],
                                    "IntervalSeconds": 2,
                                    "MaxAttempts": 3,
                                    "BackoffRate": 2
                                }
                            ],
                            "End": true
                        }
                    }
                },
                {
                    "StartAt": "UpdateTicketsCore",
                    "States": {
                        "UpdateTicketsCore": {
                            "Type": "Task",
                            "Resource": "${UpdateTicketsCoreFunctionArn}",
                            "Parameters": {
                                "game.$": "$.game"
                            },
                            "Retry": [
                                {
                                    "ErrorEquals": [
                                        "States.TaskFailed"
                                    ],
                                    "IntervalSeconds": 2,
                                    "MaxAttempts": 3,
                                    "BackoffRate": 2
                                }
                            ],
                            "End": true
                        }
                    }
                }
            ],
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "Next": "HandleError"
                }
            ],
            "Next": "ProcessJackpot"
        },
        "ProcessJackpot": {
            "Type": "Task",
            "Resource": "${ProcessJackpotFunctionArn}",
            "Parameters": {
                "game.$": "$.game"
            },
            "ResultPath": "$.jackpot",
            "Retry": [
                {
                    "ErrorEquals": [
                        "States.TaskFailed"
                    ],
                    "IntervalSeconds": 2,
                    "MaxAttempts": 3,
                    "BackoffRate": 2
                }
            ],
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "Next": "HandleError"
                }
            ],
            "Next": "Success"
        },
        "Success": {
            "Type": "Succeed"
        },
        "HandleError": {
            "Type": "Fail",
            "Error": "GameWorkflowFailed",
            "Cause": "An error occurred in the game workflow"
        }
    }
}
